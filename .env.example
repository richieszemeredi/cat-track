# Copy to .env.local and fill in from Firebase console:
# Project settings -> General -> Your apps -> SDK setup and configuration.
# These values are public identifiers, not secrets — but .env.local stays
# untracked so each checkout points at its own project.
VITE_FIREBASE_API_KEY=
# Use your HOSTING domain here (<project-id>.web.app), not <project-id>.firebaseapp.com —
# iOS Safari partitions cross-site storage and silently breaks redirect sign-in otherwise.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to 'true' to run against the local Firebase emulators (demo-cattrack).
VITE_USE_EMULATORS=
